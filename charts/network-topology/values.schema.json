{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "config", "data", "ingress"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "required": ["existingClaim", "mountPath"],
      "properties": {
        "existingClaim": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "pattern": "^/" },
        "initialPortsCsvPath": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "required": ["existingClaim", "mountPath", "accessModes", "size"],
      "properties": {
        "existingClaim": { "type": "string" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "storageClassName": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] } },
        "size": { "type": "string", "pattern": "^[0-9]+([EPTGMK]i?)?$" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "hostnames", "pathPrefix", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "hostnames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pathPrefix": { "type": "string", "pattern": "^/" },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
